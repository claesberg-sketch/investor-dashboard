  "assumptions": [
    {
      "id": "q3_actuals",
      "input": "Q3 2026 reported base",
      "value": "Revenue $14.575B; Connectivity $5.248B; consumer subs 13.6M; consumer ARPU $69; Ent/Gov $2.127B; SI $7.560B; nameplate compute 1.7 GW; Space $1.767B",
