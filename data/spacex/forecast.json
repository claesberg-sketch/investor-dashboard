    {
      "id": "q1_guide",
      "input": "Q1 2027 revenue",
      "value": "$33\u201337B official range; model uses midpoint $35B as the Q1 2027 total (drivers set so the quarter lands near that midpoint)",
      "kind": "disclosed guidance",
      "source": "Q3 2026 earnings call, CFO Bret Johnsen",
      "url": "https://www.fool.com/earnings/call-transcripts/2026/10/20/spacex-spcx-q3-2026-earnings-call-transcript/"
    },
    {
      "id": "yield",
      "input": "Realized consumer yield $78 / month",
      "value": "Official ARPU \u00d7 average subs \u00d7 3 does not reconcile to official consumer revenue (Q3: 12.8M \u00d7 $69 \u00d7 3 = $2.65B vs $3.12B reported). The model uses a $78 realized yield (~$81 in Q3, $74 in Q2) so subscriber growth maps to revenue. Disclosed ARPU remains $69\u201370 and is shown separately.",
      "kind": "estimate",
      "source": "Author calculation from official consumer revenue and subscriber counts in Q2/Q3 2026 releases",
      "url": "https://www.sec.gov/Archives/edgar/data/1181412/000162828026066482/spaceexplorationtechnologi.htm"
    },
    {
      "id": "arpu",
      "input": "Stated consumer ARPU $70",
      "value": "Held near Q3 $69 (which rose from $66 in Q1\u2013Q2). Mix of aviation/DTC/premium offsets geographic dilution. Not the revenue driver in the formula.",
      "kind": "estimate anchored to disclosed ARPU",
      "source": "Q3 2026 earnings release, consumer ARPU $69",
      "url": "https://www.sec.gov/Archives/edgar/data/1181412/000162828026066482/spaceexplorationtechnologi.htm"
    },
    {
      "id": "adds",
      "input": "Starlink consumer net adds ~1.50M in Q4 2026, tapering to ~1.30M by Q2 2028",
      "value": "Recent pace: +1.4M (Q1), +1.7M (Q2), +1.6M (Q3). V3 capacity is a positive, international mix a slower-ARPU offset. Ends 2026 at ~15.1M, 2027 at ~21.0M, mid-2028 at ~23.6M \u2014 well below some older 50M-by-2027 commentary.",
      "kind": "estimate",
      "source": "Q2/Q3 subscriber adds from earnings releases; contrasted with older NextBigFuture 50M-sub scenarios",
      "url": "https://www.nextbigfuture.com/2026/04/spacex-xai-2027.html"
    },
    {
      "id": "entgov",
      "input": "Enterprise & government +12% QoQ through Q1 2027, then +8% / +6%",
      "value": "Q3 Ent/Gov $2.127B was +18% QoQ and +91% YoY. Aviation: 3,800 aircraft equipped / 12,000 contracted; Starlink Mobile expanding (Qualcomm U.S. deal, Brazil, etc.). Pace steps down as the base grows.",
      "kind": "estimate",
      "source": "Q3 2026 release; Starlink Mobile / Qualcomm coverage Nov 4, 2026",
      "url": "https://www.cnbc.com/2026/11/04/spacex-qualcomm-starlink-mobile.html"
    },
    {
      "id": "space",
      "input": "Space segment ~$1.5B in Q4 2026, rising toward ~$2.4B by Q2 2028",
      "value": "Launch revenue is lumpy (Q1 $619M, Q2 $962M, Q3 $1.767B with first Starship revenue mission). Base case does not assume Starship immediately becomes a multi-billion-per-quarter satellite-deployment machine beyond a gradual ramp.",
      "kind": "estimate",
      "source": "Segment history in Q2/Q3 2026 releases; Flight 14 first revenue Starship mission",
      "url": "https://www.sec.gov/Archives/edgar/data/1181412/000162828026066482/spaceexplorationtechnologi.htm"
    },
    {
      "id": "gw26",
      "input": "YE 2026 nameplate compute 2.75 GW",
      "value": "Midpoint of official 2.5\u20133.0 GW year-end target (1.7 GW at Sep 30; Musk said nearly 2.2 GW in October alone).",
      "kind": "disclosed guidance (midpoint)",
      "source": "Q3 2026 earnings call",
      "url": "https://www.fool.com/earnings/call-transcripts/2026/10/20/spacex-spcx-q3-2026-earnings-call-transcript/"
    },
    {
      "id": "gw27",
      "input": "YE 2027 nameplate compute 13 GW",
      "value": "Musk: incremental ~10 GW in 2027 on top of 2.5\u20133 GW by YE2026. Path is interpolated: 5.3 / 7.9 / 10.5 / 13.0 GW at quarter-ends. Not a packed linear factory schedule \u2014 an estimate.",
      "kind": "disclosed target, interpolated path is an estimate",
      "source": "Q3 2026 call coverage",
      "url": "https://teslanorth.com/2026/10/20/spacex-2027-arr-500b-1t-q1-guidance/"
    },
    {
      "id": "dpgw",
      "input": "SI infrastructure $/GW-quarter",
      "value": "Q3 implied ~$4.1B per average GW for solutions & infrastructure ex-Cursor. Q4 uses $4.5B as contracts activate. Q1 2027 uses ~$6.09B so company revenue lands near the $35B guidance midpoint (the step-up is the CSA pipeline management pointed to). Then the rate declines toward $4.5B by Q4 2027 and $4.0B by Q2 2028 as more capacity comes online \u2014 a haircut versus simply annualizing Q1. Management's $500B\u2013$1T YE2027 ARR aspiration is not used as a revenue total.",
      "kind": "estimate, Q1 2027 calibrated to official guidance",
      "source": "Author calculation from Q3 SI solutions & infrastructure $7.022B and compute; Q1 2027 guide",
      "url": "https://www.sec.gov/Archives/edgar/data/1181412/000162828026066482/spaceexplorationtechnologi.htm"
    },
