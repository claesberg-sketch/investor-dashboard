  "satellitesMeta": {
    "definition": "Starlink payload satellites in Earth orbit at the end of each date: successfully launched and not yet reentered. One consistent source (Jonathan McDowell) for the whole series.",
    "generations": {
      "v1": "V1.0 and V1.5, including early prototypes. McDowell GCAT bus type Starlink or SpXMicro. Group 5 V1.5 is included here (V1.5 hardware), not in V2.",
      "v2": "V2 Mini, including Direct-to-Cell (bus V2MD) and V2 Mini/Opt (bus V2MO). DTC is included in the V2 bar; v2Dtc is the DTC subset.",
      "v3": "V3 satellites from Starship Flight 14 (Starlink Group 31-1) on 28 Sep 2026, 26 in orbit. Earlier V3 simulators and test batches failed to reach orbit and are not counted. V3 is 0 at all earlier quarter-ends."
    },
    "method": "Counts are built from McDowell's GCAT payload catalog (satcat.tsv and satcat100k.tsv, updated 9 Nov 2026 00:53 UTC). A satellite is in orbit on a date if its launch date is on or before that date and it has no reentry date, or the reentry date is after that date. Generation is the catalog bus type. NRO Starshield objects that used a Starlink-like bus are excluded; none of those remain in orbit in this window. Totals match McDowell's daily in-orbit series (log.dat) within 0–4 satellites.",
    "source": {
      "label": "Jonathan McDowell, GCAT and Starlink statistics",
      "urls": [
        "https://planet4589.org/space/gcat/tsv/cat/satcat.tsv",
        "https://planet4589.org/space/gcat/tsv/cat/satcat100k.tsv",
        "https://planet4589.org/space/con/star/stats.html",
        "https://planet4589.org/space/con/star/log.dat"
      ],
      "catalogUpdated": "2026-11-09T00:53:06"
    },
    "companyComparison": "These are independent in-orbit counts, not SpaceX's 'operational' figures. The prospectus cited approximately 9,600 Starlink broadband and mobile satellites as of 31 Mar 2026 (this series: 10,156 in orbit; McDowell's narrower operational-orbit class: 8,451). The Q2 2026 call cited roughly 10,200 operational satellites as of 30 Jun 2026 (this series: 10,723 in orbit; McDowell working: 10,698; operational orbit: 9,255). Definitions differ, so company figures are not plotted.",
    "latestNote": "The last point is McDowell's catalog as of 9 Nov 2026, not 11 Nov. The catalog's last new launch is 31 Oct 2026; later decays through 9 Nov are included."
  }
}
